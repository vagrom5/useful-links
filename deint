{   struct pool *pool = poolalloc(1<<17);
    if (!pool)
        logfatal("poolalloc");
    struct psi *psi = psialloc(pool, PULSEDETECTCOUNT);
    if (!psi)
        logfatal("prpalloc");

    struct coefs *coefs = malloc(sizeof(int)*3);
    memset(coefs, 0, sizeof(int)*3);
    coefs->alpha = ALPHA;
    coefs->beta = BETA;
    coefs->gamma = GAMMA;
    int psis[50]; // массив для значений ПCИ

    mvpgen(psi);
    printf("\na = %f    b = %f  gamma = %f", coefs->alpha, coefs->beta, coefs->gamma);
    printf("\nРеальные ППИ: %d  %d\n", PSI1, PSI2);

    // alg_pri_1(psi, psis, coefs);
    alg_pri_2(psi, psis, coefs);

    poolfree(pool);
    printf("\nStatus: ok\n");
}


