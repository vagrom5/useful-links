}

void pri_2_step_3(struct pri_pars *pp)
{
    float vob = VOBUL;
    int k_1 = 0, k_2 = 0;
    pp->tau = pp->t[pp->n] - pp->t[pp->m];

    if(pp->tau <= (1 - vob) * pp->tau_min) {
        pri_2_step_5(pp, k_1, k_2);
        // return;
    }
    else if(pp->tau > (1 + vob) * pp->tau_max) {
        pri_2_step_6(pp);
        // return;
    }

    // шаг 4
    int delta_tau = (pp->tau_max - pp->tau_min) / pp->K_k;
    if(delta_tau != 0) {
        k_1 = ((pp->tau/(1 + vob) - pp->tau_min) / delta_tau) + 1;
        k_2 = ((pp->tau/(1 - vob) - pp->tau_min) / delta_tau) + 1;
    }

    // printf("\n\nk1 = %d   k2 = %d", k_1, k_2);
    // printf("\nn = %d    m = %d  pp->[%d] = %d   pp->[%d] = %d", pp->n, pp->m, pp->n, pp->t[pp->n], pp->m, pp->t[pp->m]);
    // printf("\ntau_min = %d  tau_max = %d    pp->tau = %d", pp->tau_min, pp->tau_max, pp->tau);
    // printf("\n(1 - vob) * pp->tau_min = %f\n(1 + vob) * pp->tau_max = %f", (1 - vob) * pp->tau_min, (1 + vob) * pp->tau_max);


    pp->b[pp->k] = 2 * vob * pp->tau;

    pri_2_step_5(pp, k_1, k_2);
    pri_2_step_11(pp);
}

void pri_2_step_2(struct pri_pars *pp)
{
    pp->m = pp->n - 1;
    pri_2_step_3(pp);
}

//ПCИ2 для jitter
void alg_pri_2(struct psi *psi, int *psis, struct coefs *coefs)
{
    struct pri_pars *pp = malloc(sizeof(struct pri_pars));
    pp->K_k = psi->toacount - 1;
    pp->N = psi->toacount;
    pp->t = malloc(sizeof(int) * pp->N);
    memcpy(pp->t, psi->toain, sizeof(int) * pp->N);
    pp->D = malloc(sizeof(double) * pp->K_k);
    memset(pp->D, 0, sizeof(double) * pp->K_k);
    pp->c = malloc(sizeof(int) * pp->K_k);
    memset(pp->c, 0, sizeof(int) * pp->K_k);
    pp->o = malloc(sizeof(int) * pp->K_k);
    memset(pp->o, 0, sizeof(int) * pp->K_k);
    pp->b = malloc(sizeof(float) * pp->K_k);
    memset(pp->b, 0, sizeof(float) * pp->K_k);


    // начальные условия
    pp->k = 1;   // 1<=k<=K_k
    pp->n = 1;

    pp->tau_min = MINPSI;   // задаются оператором
    pp->tau_max = MAXPSI;

    pp->T = pp->t[pp->K_k] - pp->t[0];

    pri_2_step_2(pp);

    thresholds(pp, psis, coefs);

    if(pp->t != NULL) {
        free(pp->t);
        pp->t = NULL;
    }
    if(pp->D != NULL) {
        free(pp->D);
        pp->D = NULL;
    }
    if(pp->c != NULL) {
        free(pp->c);
        pp->c = NULL;
    }
    if(pp->o != NULL) {
        free(pp->o);
        pp->o = NULL;
    }
    if(pp->b != NULL) {
        free(pp->b);
        pp->b = NULL;
    }
    if(pp != NULL) {
        free(pp);
        pp = NULL;
    }
}

