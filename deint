void pri_2_step_11(struct pri_pars *pp)
{
    //шаг 11
    pp->m--;

    if (pp->m >= 1)
        pri_2_step_3(pp);
    else { //шаг 12
        pp->n++;
        if(pp->n < pp->N)
            pri_2_step_2(pp);
    }
}

void pri_2_step_6(struct pri_pars *pp)
{
    if(pp->c[pp->k] == 0) {
        pp->o[pp->k] = pp->t[pp->n];
        // printf("\nПервое использование o[%d] = %d", pp->k, pp->o[pp->k]);
    }

    int z_0 = Z_0; // -0.5 < z_0 < 0.5 - можно вынести на совесть оператора
    float nyu_0 = 0, nyu = 0;
    double tau_k = (pp->k - 0.5) / pp->K_k * (pp->tau_max - pp->tau_min) + pp->tau_min;

    if(tau_k < MINPSI || tau_k > MAXPSI) {
        printf("\nнедопустимое значение %lf", tau_k);
        return;
    }

    f++;
    printf("\nf = %d, n = %d,  m = %d,  k = %d", f, pp->n, pp->m, pp->k);

    // шаг 7
    if(tau_k != 0)
        nyu_0 = ((double)pp->t[pp->n] - (double)pp->o[pp->k]) / tau_k;
    float v = (nyu_0 + 0.5);
    float z = nyu_0 / v - 1;


    // шаг 8
    if((v == 1 && pp->t[pp->m] == pp->o[pp->k]) || (v >= 2 && abs(z) <= z_0)) {
        pp->o[pp->k] = pp->t[pp->n];
        // printf("\no[%d] = %d", pp->k, pp->o[pp->k]);
    }

    // // шаг 9
    if(tau_k != 0)
        nyu = (pp->t[pp->n] - pp->o[pp->k]) / tau_k;

    // printf("\nm = %d    n = %d  pp->o[%d] = %d", pp->m, pp->n, pp->k, pp->o[pp->k]);
    // printf("\nt[%d] = %d    t[%d] = %d", pp->m, pp->t[pp->m], pp->n, pp->t[pp->n]);
    // шаг 10
    if(pp->k > 0 && pp->k < pp->K_k) {
        pp->D[pp->k] += cos(2 * PI * (double)nyu);
        pp->c[pp->k]++;
        // printf("\nD[%d] = %lf   c = %d", pp->k, pp->D[pp->k], pp->c[pp->k]);
        // printf("\nc[%d] = %d", pp->k, pp->c[pp->k]);
    }

    // pri_2_step_11(pp);
}

void pri_2_step_5(struct pri_pars *pp, int k_1, int k_2)
{
    //проверки k
    if(k_1 < 1)
        k_1 = 1;
    if(k_2 >= pp->K_k)
        k_2 = pp->K_k - 1;
    if(k_1 > k_2)
        return;
    for(pp->k = k_1; pp->k <= k_2; pp->k++) {
        pri_2_step_6(pp);
    }

    //сглаживание
    // for(int i = 2; i <  pp->K_k - 2; i++)
