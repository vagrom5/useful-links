struct psi *psialloc(struct pool *pool, int psicount)
{
    struct psi *psi = poolnew(pool, struct psi, 1);
    if (psi) {
        psi->toacount = psicount;
        psi->toain = poolnew(pool, int, psicount);
        if (psi->toain)
            return psi;
        else
            return NULL;
    }
    else
        return NULL;
}

// на 2 пси
