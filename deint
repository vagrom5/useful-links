void thresholds(struct pri_pars *pp, int *psis, struct coefs *coefs)
{
    int l = 0;
    FILE *hist = fopen("hist_res.txt", "w");
    FILE *thr = fopen("thr_res.txt", "w");

    if(hist == NULL || thr == NULL)
        printf("\nОшибка открытия файла записи");

    for (int k = 1; k < pp->K_k; k++) {

        double tau_k = (k - 0.5) / pp->K_k * (pp->tau_max - pp->tau_min) + pp->tau_min;
        // printf("\n\ntau_k = %lf   k = %d  pp->K_k = %d\ntau_max = %d    tau_min = %d", tau_k, k, pp->K_k, pp->tau_max, pp->tau_min);
        // printf("\npp->t_max = %d    pp->c = %d\nN = %d  pp->b = %d", pp->t_max, pp->c[k], pp->N, pp->b[k]);

        double a = MAX(coefs->alpha * pp->T / tau_k, MAX(coefs->beta * pp->c[k], coefs->gamma * sqrt(pp->N * pp->N * pp->b[k] / pp->T)));

        if(isnan(a)) {
            a = 0;
        }

        fprintf(hist,"%lf\n" , pp->D[k]);
        fflush(hist);
        fprintf(thr,"%lf\n" , a);
        fflush(thr);

        // printf("\nD[%d] = %lf   a = %lf     tau_k = %lf", k, pp->D[k], a, tau_k);

        if(pp->D[k] > a) {
            psis[l] = tau_k;
            printf("\nППИ %d = %d   D[%d] = %lf     a = %lf", l, psis[l], k, pp->D[k], a);
            // printf("\n%lf   %lf     %lf", coefs->alpha * pp->tau_max / tau_k, coefs->beta * pp->c[k], coefs->gamma * sqrt(pp->N * pp->N * pp->b[k] / pp->tau_max));
            l++;
        }
    }
    fclose(hist);
    fclose(thr);
}

