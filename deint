{
    int *toain = psi->toain;
    int i = 1, j = 1, k = 1;
    printf("\ntoa:\n");
    for (int n = 0; n < psi->toacount; n++) {
        if (i*PSI1 < j*PSI2) {
            toain[n] = i*PSI1;
            i++;
        } else {
            toain[n] = j*PSI2;
            j++;
        }
        printf("%d    ", toain[n]);
    }
    printf("\n");
}

